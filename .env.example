# Required: AWS Region for AgentCore API calls
AWS_REGION=us-east-1

# AWS Credentials (optional - uses AWS credential chain if not set)
# AWS_ACCESS_KEY_ID=your-access-key-here
# AWS_SECRET_ACCESS_KEY=your-secret-key-here
# AWS_SESSION_TOKEN=your-session-token-here

# Server binding configuration (what the server actually runs on)
# HOST=0.0.0.0
# PORT=2972

# A2A server address configuration (what external services use to reach this)
# For local development, defaults to localhost
# For minikube development, use host.minikube.internal so ARK can reach this service
# EXPOSE_HOST=localhost
# EXPOSE_PORT=2972

# Optional: Base path for URLs (e.g., /api)
# BASE_PATH=

# Optional: Agent discovery refresh interval in seconds (defaults to 30)
# AGENT_REFRESH_INTERVAL_SECONDS=30

# Optional: Enable streaming responses from agents (1=on, 0=off, defaults to 1)
# ENABLE_STREAMING=1

# Optional: Enable agent descriptions as A2A skills (1=on, 0=off, defaults to 1)
# ENABLE_DESCRIPTION_AS_A2A_SKILL=1

# Optional: Log level (defaults to INFO)
# LOG_LEVEL=INFO

